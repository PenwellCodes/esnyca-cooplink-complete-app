# Production Environment Configuration
# Copy this to your remote server and update with actual values

PORT=4000
HOST=0.0.0.0

# JWT (generate a new secret for production)
JWT_SECRET=your_secure_random_jwt_secret_here

# SQL Server (Production Database)
SQL_USER=your_production_sql_username
SQL_PASSWORD=your_production_sql_password
SQL_SERVER=your.production.sql.server.address
SQL_DATABASE=your_production_database_name
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERT=false

# ImageBB (Production API Key)
IMGBB_API_KEY=your_production_imgbb_api_key

# Firebase (Production API Key - same as development)
FIREBASE_WEB_API_KEY=your_firebase_web_api_key

# Frontend URL (Critical for password reset emails)
FRONTEND_URL=https://yourdomain.com